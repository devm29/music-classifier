# Copy to .env to override the defaults. `docker compose` reads .env from the
# project root; a local `manage.py` run reads the same names from the shell.
# Every value below is optional and shown at its compose default.

# Django signing key. Generate a real one for anything reachable by others:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CSRF_TRUSTED_ORIGINS=http://localhost:8310
# 1 behind TLS; 0 for the plain-HTTP localhost demo, or every POST is a 403.
SECURE_COOKIES=0
# Analyses kept before the oldest are pruned with their audio.
HISTORY_LIMIT=20
